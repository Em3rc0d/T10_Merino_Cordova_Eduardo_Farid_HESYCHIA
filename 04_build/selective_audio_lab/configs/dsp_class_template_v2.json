{
  "schema": "hesychia.dsp-class-template-config.v2",
  "baseline_id": "DSP_CLASS_TEMPLATE_V2",
  "conditioning": "target_id",
  "inference_inputs": ["mixture_waveform", "target_id"],
  "forbidden_test_inputs": ["target_stem", "protected_stem", "background_stem", "oracle_mask"],
  "template_fit_partition": "training_only_after_corpus_exclusions",
  "frontend": {
    "sample_rate_hz": 16000,
    "n_fft": 512,
    "hop_samples": 160,
    "bins": 257,
    "window": "sqrt-periodic-Hann",
    "left_padding_samples": 352,
    "tail_hops": 3,
    "synthesis": "normalized-WOLA-offline-reference"
  },
  "per_clip_feature": "l1_normalized_mean_power_spectrum_on_exact_M4_scientific_STFT",
  "class_aggregation": "median",
  "rest_aggregation": "median_over_non_target_training_clips",
  "mask_formula": "T_c(f)/(T_c(f)+R_c(f)+eps)",
  "temporal_behavior": "static_frequency_mask_broadcast_over_scientific_frames",
  "policy": {
    "m3b_applies_before_method": true,
    "alpha": 1.0,
    "cap_db": 12.0,
    "gain_formula": "max(1-mask,10^(-cap_db/20))",
    "block_behavior": "bit_exact_bypass"
  },
  "freeze_rule": "code_config_templates_training_manifest_sha256_before_confirmatory_inference",
  "tuning_rule": "no_test_tuning; any optional selection uses validation only",
  "purpose": "non_learned_target_conditioned_baseline_with_exact_frontend_parity_to_M4_CNN"
}
